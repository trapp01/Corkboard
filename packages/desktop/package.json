{
  "name": "@corkboard/desktop",
  "productName": "Corkboard",
  "version": "0.1.0",
  "description": "Corkboard desktop app: a Corkboard server on this computer with a window onto it.",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "esbuild src/main.ts src/preload.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outdir=dist --out-extension:.js=.cjs",
    "dev": "pnpm run build && electron .",
    "smoke": "pnpm run build && tsx scripts/smoke.ts",
    "package": "pnpm run build && npx --yes electron-builder@26.18.0 --config electron-builder.config.cjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@corkboard/server": "workspace:*",
    "@corkboard/sync": "workspace:*",
    "@playwright/test": "^1.65.1",
    "electron": "^45.3.2",
    "esbuild": "^0.28.2"
  }
}
