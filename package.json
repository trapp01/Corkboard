{
  "name": "corkboard",
  "description": "An open-source, self-hosted kanban board that people and AI agents work from together, with offline editing and sync through your own server.",
  "private": true,
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trapp01/Corkboard.git"
  },
  "homepage": "https://github.com/trapp01/Corkboard#readme",
  "bugs": "https://github.com/trapp01/Corkboard/issues",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "dev": "pnpm --filter @corkboard/server --filter @corkboard/web --parallel dev",
    "start": "pnpm --filter @corkboard/web build && pnpm --filter @corkboard/server build && node packages/server/dist/server.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
